<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">

  <!-- Vehicle Parameters -->
  <xacro:property name="wheel_base" value="0.8"/>
  <xacro:property name="wheel_separation" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_elevation" value="0.12"/>
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="knuckle_mass" value="0.2"/>
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_y" value="0.0"/>
  <xacro:property name="sensor_z" value="0.38"/>

  <!-- Materials -->
  <material name="chassis_blue">
    <color rgba="0.05 0.36 0.72 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="sensor_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.55" iyy="1.10" izz="1.40" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_elevation}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Macro for wheel cylinder inertia -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*r*r/2}" izz="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- Steering Knuckles (Front) -->
  <link name="front_left_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${knuckle_mass}"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="${wheel_base / 2.0} ${wheel_separation / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25.0" velocity="2.0"/>
  </joint>

  <link name="front_right_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${knuckle_mass}"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="${wheel_base / 2.0} ${-wheel_separation / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25.0" velocity="2.0"/>
  </joint>

  <!-- Wheel Macro -->
  <xacro:macro name="wheel" params="prefix parent x y is_front">
    <link name="${prefix}_wheel">
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}_wheel"/>
      <xacro:if value="${is_front}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:if>
      <xacro:unless value="${is_front}">
        <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      </xacro:unless>
      <axis xyz="0 1 0"/>
      <limit effort="25.0" velocity="20.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left" parent="front_left_knuckle" x="${wheel_base/2}" y="${wheel_separation/2}" is_front="true"/>
  <xacro:wheel prefix="front_right" parent="front_right_knuckle" x="${wheel_base/2}" y="${-wheel_separation/2}" is_front="true"/>
  <xacro:wheel prefix="rear_left" parent="base_link" x="${-wheel_base/2}" y="${wheel_separation/2}" is_front="false"/>
  <xacro:wheel prefix="rear_right" parent="base_link" x="${-wheel_base/2}" y="${-wheel_separation/2}" is_front="false"/>

  <!-- Sensors attached to base_link -->
  <!-- Camera -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" iyy="0.000333333333" izz="0.000333333333" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- Lidar -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" iyy="0.000333333333" izz="0.000333333333" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.033333333334"/>
      <inertia ixx="0.000333333334" iyy="0.000333333334" izz="0.000333333334" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

</robot>
